# HabItiva configuration
#
# Device builds (npm run build:android) intentionally ship WITHOUT a server.
# Leave NEXT_PUBLIC_HABITFLOW_SERVER unset for the offline device experience —
# the auth screens use an honest local profile and nothing leaves the device.

# ----- Device / local-only (default, recommended) -----
# Nothing is required. All data is stored in a local SQLite database.

# ----- Server deployments (optional) -----
# When the app is served from a real Node backend, set these to enable the
# email/password and Google sign-in paths on the same auth screen.

# Build-time flag that switches the auth screen to use the server backend.
# NEXT_PUBLIC_HABITFLOW_SERVER="1"

# Must be a real Postgres database for the server build.
# DATABASE_URL="postgresql://user:password@host:5432/habitcoach?schema=public"

# Long random string used to sign session cookies.
# AUTH_SECRET="replace-with-a-long-random-string"

# Google Cloud OAuth 2.0 client (https://console.cloud.google.com/apis/credentials).
# Create an OAuth client ID of type "Web application" and add your own origin;
# the app uses the Google Identity Services popup flow (no redirect URI needed).
# GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"

# Optional: server-side coach/insight content generation.
# OPENAI_API_KEY=""

# Production Coach API (/api/coach/*): comma-separated origins allowed for
# cross-origin calls (the future Capacitor APK). Same-origin web calls need
# nothing. P1 values: capacitor://localhost,http://localhost
# COACH_ALLOWED_ORIGINS=""

# OpenAI configuration for AI coach (all optional, with sensible defaults)
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TEMPERATURE="0.2"
# OPENAI_MAX_TOKENS="200"
# OPENAI_MAX_DAILY_REQUESTS="50"
# OPENAI_MAX_HOURLY_REQUESTS="10"
# OPENAI_CACHE_TTL_MINUTES="60"

# Public base URL of the hosted backend (used by clients to reach the API;
# HTTPS required in production). Read by future P1 Android transport — no
# current server code depends on it yet.
# NEXT_PUBLIC_HABITIVA_API_URL="https://your-backend-domain.com"

# Transactional email (Resend) for verification + password-reset delivery.
# Server-only: RESEND_API_KEY must never use a NEXT_PUBLIC_ prefix.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# Sender address, changeable later to a custom Habitiva domain with no code changes.
# Until then the Resend testing sender applies (delivers only to the Resend account address).
# EMAIL_FROM="HabItiva <onboarding@resend.dev>"
# EMAIL_VERIFICATION_URL="https://your-domain.com/verify-email?token="
# EMAIL_PASSWORD_RESET_URL="https://your-domain.com/reset-password?token="

# ----- Android release signing (Google Play) -----
# Release builds stay UNSIGNED unless android/keystore.properties exists.
# Create it locally (never commit it; it is gitignored):
#   storeFile=habitiva-release.jks
#   storePassword=<keystore-password>
#   keyAlias=habitiva
#   keyPassword=<key-password>
# Then enroll the upload key in Play Console > App signing (Play App Signing).